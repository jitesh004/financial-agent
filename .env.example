# Copy to .env and fill in what you need.
#
# Under Docker this whole file is handed to the backend container, so a
# variable you add here arrives without touching docker-compose.yml. What each
# setting is called and what it defaults to lives in backend/app/config.py.
#
# Two things to know. env_file reads this FILE, so a variable exported in your
# shell does not reach the container - put it here instead. And the few
# container-shaped values named in the compose files (FA_DATABASE_URL,
# FA_DATA_DIR) deliberately override what is written here, because the paths
# and hostnames a container needs are not the ones the host needs.

# ---- Database -------------------------------------------------------------
# The role here must NOT be a superuser and must not hold BYPASSRLS:
# PostgreSQL exempts both from row-level security, which is what keeps one
# signed-in user out of another's statements. The app refuses to start
# otherwise. docker-compose sets this up for you (deploy/postgres-init.sh).
FA_DATABASE_URL=postgresql://financial_agent:financial_agent@localhost:5432/financial_agent

# Where statement files, the Gmail cache and per-user snapshots live.
# FA_DATA_DIR=./data

# How many statements are fetched and parsed at once. Turn this down on a
# small host: it is also how many are held in memory simultaneously, and on a
# fraction of a core a wide pool costs footprint without adding throughput.
# On Oracle's 1 GB E2.1.Micro, use 2.
# FA_PARSE_WORKERS=8

# ---- Signing in (Google) --------------------------------------------------
# Create a *Web application* OAuth client in Google Cloud Console and register
# <FA_APP_BASE_URL>/api/auth/google/callback as an authorised redirect URI.
FA_APP_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Who may see the operator's view - the Admin tab: which accounts exist on this
# deployment, how often each comes back, how much each has imported. Comma
# separated, exact addresses only (a whole @domain is refused: this is meant to
# be one or two named people who run the deployment, not an access tier).
#
# Empty means there is no admin, which is the right default for a grant nobody
# can give themselves. It is read from here rather than stored in the database
# or offered as a toggle, because either of those would be editable by whatever
# it is meant to be protecting.
FA_ADMIN_EMAILS=

# Optional. Empty means anyone with a Google account can sign up. Otherwise a
# comma-separated list of addresses or @domains.
# FA_ALLOWED_SIGNINS=you@example.com,@yourcompany.com

# How long a session lasts, and whether its cookie is TLS-only. Turn the
# second on for any deployment that is not http://localhost.
# FA_SESSION_TTL_HOURS=72
# FA_SESSION_COOKIE_SECURE=true

# ---- Production only (docker-compose.prod.yml) -----------------------------
# The domain must already resolve to the host's public IP before first start:
# Let's Encrypt proves ownership over port 80, so wrong DNS means no
# certificate. Google will not accept an http:// redirect URI for anything but
# localhost, which is why TLS is not optional in production.
# FA_DOMAIN=finance.example.com
# FA_TLS_EMAIL=you@example.com
# Two independent secrets. Generate them - they are never typed by a human:
#     openssl rand -hex 24
# Use HEX, not base64: FA_DB_PASSWORD goes into a postgresql:// URL, and the
# / and + that base64 produces would truncate it. The database role is created
# with FA_DB_PASSWORD on the volume's first initialisation, so changing it
# later needs an ALTER ROLE as well - see the README.
# POSTGRES_PASSWORD=...
# FA_DB_PASSWORD=...

# ---- Language model (optional) --------------------------------------------
# Without a key the app still works completely; you lose only the written
# narrative and the unknown-merchant tail.
# Choose 'gemini', 'openrouter' or 'azure'
LLM_PROVIDER=openrouter

# ---- Agents ----------------------------------------------------------------
#
# How much prompt one agent run may spend.
#
#   auto     (default) read the configured model's name and pick
#   compact  5 steps, small tool results, the agent's short brief
#   full     10 steps, large tool results, the agent's full brief
#
# This matters more than it sounds. Gemini's free tier meters INPUT TOKENS
# PER MINUTE - 16,000, shared across every call made in the same minute - and
# a full run costs around 90,000 of them. That is not a slow run, it is a
# cascade of 429s and no answer. A compact run costs under 7,000, so it fits
# one minute's budget once.
#
# Worth forcing to compact on any metered tier even behind a large model.
FA_AGENT_PROFILE=auto

# ---- Gemini, natively -----------------------------------------------------
# Google's own API rather than its OpenAI-compatible endpoint. Both reach the
# same models and the compatible one needs no provider at all (see the block
# further down); this one exists for what that route cannot express:
#
#   - responseSchema takes an ARRAY at its root, so the categoriser is handed
#     a list directly. Through response_format it cannot be: JSON mode there
#     promises an object, so the request has to ask for {"results": [...]}
#     and unwrap it.
#   - systemInstruction is a field, not a message with a role. The Gemma
#     models honour the field and ignore the message - fold the system text
#     into the prompt instead and a batch comes back as an empty array.
#
# Free-tier quota is per model per day and small: 20 requests a day on
# gemini-3.6-flash. Requests, not tokens, are what runs out, so the
# categoriser's forty-merchants-per-call batching is what makes it usable.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key
# Categorisation and letterhead lookups. On a fixed benchmark, same prompt
# and schema at temperature 0:
#
#   gemma-4-31b-it       10/10, 20/20, 39/40   (the one miss defensible)
#   gemma-4-26b-a4b-it    8/10, 16/20, 37/40, and about 12/20 on a harder
#                         list - pharmacy read as tax, rent as interest
#                         income - plus duplicate indices in every batch
#
# The 26B is a mixture-of-experts activating ~4B parameters a token, so it is
# quicker and cheaper; the 31B is dense and matches gemini-3.6-flash on this
# task while drawing on a separate daily quota. Prefer the 31B.
# GEMINI_MODEL_FAST=gemma-4-31b-it
# GEMINI_MODEL_STRONG=gemma-4-31b-it

# If using OpenRouter. The two defaults below are billed at zero per token.
# "Free" is not "unlimited": OpenRouter allows 20 requests a minute and 50 a
# day on any :free model, raised to 1000 a day once the account has bought
# $10 of credit. Requests, not tokens, are what you run out of.
#   openrouter.ai/keys        -> the key
#   openrouter.ai/models?max_price=0 -> the current free catalogue
OPENROUTER_API_KEY=your_api_key_here
# Categorisation and letterhead lookups - the high-volume path. A
# mixture-of-experts that activates under 4B parameters per token, so it is
# quick, and it honours response_format: json_object.
# A `:free` model shares one upstream rate-limit pool with every other free
# user on OpenRouter, separately from your own per-key quota, and returns
# 429 whenever that pool is saturated - five consecutive attempts failed
# when this was last tried. Drop the `:free` suffix to pay per token if
# categorisation reports nothing from the model.
OPENROUTER_MODEL_FAST=google/gemma-4-26b-a4b-it:free
# The written narrative - one call, and the only prose a person reads.
OPENROUTER_MODEL_STRONG=z-ai/glm-5.2:free
# low | medium | high, or empty to send no reasoning directive. Low suits
# classification; raise it if the narrative reads thin.
# OPENROUTER_REASONING_EFFORT=low
# Turn off only if you point the models above at one that rejects
# response_format: json_object.
# OPENROUTER_JSON_MODE=true

# Going to Gemini, without a code change. Gemini serves an
# OpenAI-compatible endpoint, which is the same shape this provider speaks,
# so it is reached by repointing the base URL rather than by a second
# provider. Keep OPENROUTER_REASONING_EFFORT set when you do, rather than
# clearing it: Gemini 3.x flash thinks by default and charges that thinking
# to max_tokens, so the 100-token letterhead lookup comes back empty
# without it.
#
# Do not use gemini-2.5-flash or -pro here. They still appear in the model
# listing but are refused for keys created since their retirement, with a
# 404 naming gemini-3.6-flash as the replacement. The 3.x *pro* models are a
# separate matter: they answer with 429 on a free-tier key, which is why the
# narrative below shares the flash model rather than reaching for pro.
# LLM_PROVIDER=openrouter
# OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENROUTER_API_KEY=your_gemini_api_key
# OPENROUTER_MODEL_FAST=gemini-3.6-flash
# OPENROUTER_MODEL_STRONG=gemini-3.6-flash
# OPENROUTER_REASONING_EFFORT=low

# If using Azure
# AZURE_OPENAI_ENDPOINT=...
# AZURE_OPENAI_API_KEY=...
